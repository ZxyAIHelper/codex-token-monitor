{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Node",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "outDir": ".test-dist",
    "jsx": "react-jsx"
  },
  "include": [
    "src/components/AlertList.tsx",
    "src/i18n.ts",
    "src/sessionTitles.ts",
    "src/statusIslandDock.ts",
